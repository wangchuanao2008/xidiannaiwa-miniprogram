:host { display: block; }
.cover { display: flex; align-items: center; height: 365rpx; padding: 18rpx 24rpx; background: #fff; overflow: hidden; box-sizing: border-box; }
.frog-panel, .github-panel { height: 100%; box-sizing: border-box; }
.frog-panel { position: relative; width: 56%; }
.frog { display: block; width: 100%; height: 100%; }
.frog-panel::after { content: ""; position: absolute; top: 0; right: 0; bottom: 0; left: 0; pointer-events: none; background: linear-gradient(90deg, #fff 0%, rgba(255,255,255,0) 12%, rgba(255,255,255,0) 78%, #fff 100%), linear-gradient(0deg, #fff 0%, rgba(255,255,255,0) 18%, rgba(255,255,255,0) 86%, #fff 100%); }
.github-panel { display: flex; flex-direction: column; align-items: center; justify-content: center; width: 44%; }
.github-mark { display: block; width: 166rpx; height: 166rpx; }
.github-name { margin-top: 20rpx; color: #24292f; font-size: 34rpx; font-weight: 600; }
